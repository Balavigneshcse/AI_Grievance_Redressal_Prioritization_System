# Copy to .env (gitignored). These are local development values for the docker-compose services.

# PostgreSQL 17 + pgvector from docker-compose.yml (host port 5434)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/synapse

# Mailpit from docker-compose.yml; swap for a real SMTP server in production
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=grievance@synapse.local
SMTP_TLS=false

# Local models through Ollama
OLLAMA_HOST=http://localhost:11434
SYNAPSE_LLM=gemma3:4b
SYNAPSE_EMBED=bge-m3

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Pipeline
REVIEW_CONFIDENCE_THRESHOLD=0.70
DUPLICATE_SCORE_THRESHOLD=0.85
MEDIA_DIR=media
