# Copy to .env (gitignored). These are local development values for the docker-compose services.

# PostgreSQL 17 + pgvector from docker-compose.yml (host port 5434)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/synapse

# Mail. Default: Mailpit from docker-compose.yml (inbox at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=grievance@synapse.local
SMTP_TLS=false

# Real delivery through Gmail: create an App Password (Google Account > Security >
# 2-Step Verification > App passwords), put the values in .env ONLY (never commit),
# then restart the API. Test with:  python scripts/test_email.py you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your.address@gmail.com
# SMTP_TLS=true

# Local models through Ollama
OLLAMA_HOST=http://localhost:11434
SYNAPSE_LLM=gemma3:4b
SYNAPSE_EMBED=bge-m3

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Pipeline
REVIEW_CONFIDENCE_THRESHOLD=0.70
DUPLICATE_SCORE_THRESHOLD=0.85
MEDIA_DIR=media

# Evidence limits (the frontend mirrors them)
MAX_PHOTO_MB=25
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=300

# Keep Gemma loaded between complaints (Ollama keep_alive) and the login URL used in staff welcome emails
LLM_KEEP_ALIVE=2h
APP_URL=http://localhost:5173
